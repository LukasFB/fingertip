{
  "name": "fingertip-agent",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "eslint src tests rollup.config.mjs eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "reload": "npm run build && streamdeck restart com.lukas-bhm.fingertip",
    "watch": "rollup -c -w"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "24.0.13",
    "eslint": "10.7.0",
    "rollup": "4.62.2",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0"
  }
}
