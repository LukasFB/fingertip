{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.lukas-bhm.fingertip",
  "Name": "Fingertip Agent",
  "Version": "1.1.2.0",
  "Author": "Lukas Böhm",
  "Description": "See live ChatGPT Codex task status, open the right task, and select its model and thinking level from Stream Deck.",
  "Category": "Fingertip Agent",
  "CategoryIcon": "imgs/plugin/category-list",
  "Icon": "imgs/plugin/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "ApplicationsToMonitor": {
    "mac": [
      "com.openai.codex"
    ]
  },
  "Actions": [
    {
      "UUID": "com.lukas-bhm.fingertip.task",
      "Name": "Codex Task",
      "Icon": "imgs/actions/task/action-list",
      "Tooltip": "Shows and opens a ranked local ChatGPT Task.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/task-key.html",
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/task/key"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.model",
      "Name": "Codex Model",
      "Icon": "imgs/actions/model/action-list",
      "Tooltip": "Applies your chosen model and thinking level to the active ChatGPT thread.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/model/key"
        }
      ],
      "PropertyInspectorPath": "ui/model-key.html"
    },
    {
      "UUID": "com.lukas-bhm.fingertip.fast-mode",
      "Name": "Fast Mode",
      "Icon": "imgs/actions/model/action-list",
      "Tooltip": "Toggles Fast Mode for the active ChatGPT thread.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/model/key"
        }
      ]
    }
  ]
}