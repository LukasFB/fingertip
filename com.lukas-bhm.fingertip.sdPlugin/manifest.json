{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.lukas-bhm.fingertip",
  "Name": "Fingertip",
  "Version": "0.1.0.0",
  "Author": "Lukas Böhm",
  "Description": "Put your local ChatGPT sidebar Tasks on Stream Deck.",
  "Category": "Fingertip",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "ApplicationsToMonitor": {
    "mac": [
      "com.openai.codex"
    ]
  },
  "Actions": [
    {
      "UUID": "com.lukas-bhm.fingertip.task",
      "Name": "Task",
      "Icon": "imgs/actions/task/action",
      "Tooltip": "Shows and opens a ranked local ChatGPT Task.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/task-key.html",
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/task/key"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.fast-mode",
      "Name": "Fast Mode",
      "Icon": "imgs/actions/fast-mode/action",
      "Tooltip": "Toggles Fast Mode in the currently visible ChatGPT composer.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/fast-mode-key.html",
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/fast-mode/key"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.voice-input",
      "Name": "Voice Input",
      "Icon": "imgs/plugin/plugin",
      "Tooltip": "Toggles ChatGPT global dictation without focusing ChatGPT.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/voice-input-key.html",
      "UserTitleEnabled": true,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/plugin/plugin",
          "Title": "VOICE"
        }
      ]
    }
  ]
}
