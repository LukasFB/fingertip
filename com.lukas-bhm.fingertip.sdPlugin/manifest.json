{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.lukas-bhm.fingertip",
  "Name": "Fingertip Agent",
  "Version": "1.0.5.0",
  "Author": "Lukas Böhm",
  "Description": "See live ChatGPT Codex task status on Stream Deck and open the right task with one press.",
  "Category": "Fingertip Agent",
  "CategoryIcon": "imgs/plugin/category-list",
  "Icon": "imgs/plugin/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "ApplicationsToMonitor": {
    "mac": [
      "com.openai.codex"
    ]
  },
  "Profiles": [
    {
      "Name": "profiles/codex-model-selector",
      "DeviceType": 2,
      "DontAutoSwitchWhenInstalled": true,
      "Readonly": true
    }
  ],
  "Actions": [
    {
      "UUID": "com.lukas-bhm.fingertip.task",
      "Name": "Codex Task",
      "Icon": "imgs/actions/task/action-list",
      "Tooltip": "Shows and opens a ranked local ChatGPT Task.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/task-key.html",
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/task/key"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.model-selector",
      "Name": "Model Selector",
      "Icon": "imgs/actions/model-selector/action-list",
      "Tooltip": "Selects the model and thinking level for the active ChatGPT Task.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/model-selector/key"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.model-option",
      "Name": "Model Option",
      "Icon": "imgs/actions/model-selector/action-list",
      "Tooltip": "Sets the model and thinking level for the active ChatGPT Task.",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/model-options/sol-low"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.fast-mode",
      "Name": "Fast Mode",
      "Icon": "imgs/actions/model-selector/action-list",
      "Tooltip": "Toggles Fast Mode for the Task targeted by Model Selector.",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/model-selector/key"
        }
      ]
    },
    {
      "UUID": "com.lukas-bhm.fingertip.model-selector-back",
      "Name": "Back",
      "Icon": "imgs/actions/model-selector/action-list",
      "Tooltip": "Returns to the previous Stream Deck profile.",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/model-selector/back"
        }
      ]
    }
  ]
}